{
  "schema_version": 1,
  "model_id": "AWG-BOOTSTRAP-TOPOLOGY",
  "states": ["planned", "open", "in_progress", "done", "blocked", "cancelled", "superseded"],
  "initial": "planned",
  "transitions": [
    {"from": "planned", "to": "open"},
    {"from": "open", "to": "in_progress"},
    {"from": "in_progress", "to": "in_progress"},
    {"from": "in_progress", "to": "open"},
    {"from": "in_progress", "to": "blocked"},
    {"from": "in_progress", "to": "done"},
    {"from": "in_progress", "to": "cancelled"},
    {"from": "in_progress", "to": "superseded"},
    {"from": "blocked", "to": "open"},
    {"from": "superseded", "to": "done"}
  ],
  "forbidden_transitions": [
    {"from": "planned", "to": "in_progress"},
    {"from": "planned", "to": "done"},
    {"from": "open", "to": "done"},
    {"from": "done", "to": "in_progress"}
  ],
  "task_id_pattern": "^AR-[0-9]{4}$",
  "require_contiguous_ids": true,
  "dependency_ready_statuses": ["open", "in_progress", "done"],
  "scope": "all tracked tasks under tasks/"
}
